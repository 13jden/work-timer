# Salary Timer 后端 · 环境变量（server/）
#
# 复制成 server/.env 后按需修改（server/.env 已被 .gitignore 忽略）。
# docker-compose 会自动读取 server/.env 里以 SERVER_ 前缀的变量映射进容器。

# 服务端口（容器内监听）
PORT=8787

# SQLite 数据库文件路径（挂卷持久化）
DB_PATH=/data/salary-timer.db

# 管理后台账号 / 密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=2018Skskwain

# token 签名密钥（生产环境请改成随机长串）
SESSION_SECRET=salary-timer-change-me-in-production
SESSION_TTL_MS=43200000
