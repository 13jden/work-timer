{
  "name": "work-timer",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "实时薪资计时器 — Tauri + React + TypeScript 重构版",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "jsdom": "^30.0.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vitest": "^4.1.11"
  }
}
