# Salary Timer · Caddy 站点配置
#
# 站点地址与证书模式由 docker-compose.yml 注入的环境变量决定(Caddyfile 解析时做文本替换):
#
#   有域名(推荐) SITE_ADDRESS=salary.example.com   TLS_ARG=you@example.com
#                → Caddy 自动向 Let's Encrypt 申请证书并自动续签,自动 80→443 跳转
#                → 需要服务器 80 和 443 都能从公网访问(云安全组要放行)
#
#   无域名(纯 IP) SITE_ADDRESS=:443                TLS_ARG=internal
#                → 用 Caddy 内置 CA 自签证书,浏览器会警告需手动信任
#                → 注意:证书不受信任时 Service Worker / PWA 安装不保证可用,正式用请配域名
#
# 两个变量都带默认值(:443 / internal),所以不配 .env 也能直接起来。
# 占位符语法 {$VAR:default} —— 变量未设置或为空时取默认值。

{$SITE_ADDRESS::443} {
	tls {$TLS_ARG:internal}

	root * /srv
	encode zstd gzip

	# PWA:Service Worker 与 manifest 必须每次回源校验,否则新版本永远发不到客户端
	@pwa path /sw.js /manifest.webmanifest
	header @pwa Cache-Control "no-cache, no-store, must-revalidate"

	# HTML 不做强缓存,保证发版即时生效
	@html path / /index.html *.html
	header @html Cache-Control "no-cache"

	# 其余静态资源文件名带 hash,可以长期 immutable(sw.js 已被上面排除)
	@static {
		not path /sw.js
		path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.ttf *.eot
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	# SPA 路由:任何不存在的路径回 index.html
	try_files {path} /index.html
	file_server
}
