# Salary Timer · Caddy 站点配置
#
# 站点地址:默认 persecond.work,可用服务器项目目录 .env 里的 SITE_DOMAIN 覆盖
# (Caddyfile 占位符 {$VAR:default}:变量未设置或为空时取默认值)
#
# 证书:Let's Encrypt 自动签发 + 自动续签(HTTP-01 走 80,TLS-ALPN-01 走 443,两者都可用)。
# 前提:阿里云安全组放行 80 和 443;域名 A 记录指向本机(已确认 persecond.work -> 47.104.228.220)。
#
# 端口归属:阿里云建站产品曾以容器形式抢占 80/443,deploy.yml 会在 compose up 之前
# 停掉占用这两个端口的非 work-timer 容器并禁止其自启,因此 80/443 都归 Caddy。
#
# 想临时用自签证书(比如域名还没解析好):把下面 tls 块整段替换成 `tls internal` 即可。
#
# ── 路由结构(v3.2)────────────────────────────────────────
# 所有请求都走 handle 块,块与块之间互斥,按匹配器具体度排序:
#   /api/*  → api 容器(Node + SQLite)
#   /admin* → api 容器(管理后台静态页)
#   /health → api 容器(存活探针)
#   其余    → 静态站点(SPA fallback)
#
# 注意:不要把 try_files / file_server 提到 handle 块外面。
# Caddy 的指令顺序里 try_files 排在 handle 之前,那样 /api/ping 会被
# try_files 重写成 /index.html,永远到不了后端。

{$SITE_ADDRESS:persecond.work} {
	encode zstd gzip

	# PWA:Service Worker 与 manifest 必须每次回源校验,否则新版本永远发不到客户端
	@pwa path /sw.js /manifest.webmanifest
	header @pwa Cache-Control "no-cache, no-store, must-revalidate"

	# HTML 不做强缓存,保证发版即时生效
	@html path / /index.html *.html
	header @html Cache-Control "no-cache"

	# 其余静态资源文件名带 hash,可以长期 immutable(sw.js 已被上面排除)
	@static {
		not path /sw.js
		path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.ttf *.eot
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	# ── 后端 API 反代 ──
	#
	# /api/ping 是「后台遥测」(日活上报),失败必须**完全无声**:
	#   浏览器会把任何非 2xx 响应打印成红色 console error,而这条请求
	#   是 App 每次打开自动发的,后端容器一挂就会刷屏。
	#
	# 所以这里把「后端不可达」改写成 200 + { ok:false }:
	#   - 前端据此判定「今天没记上」,不写本地标记,下次打开 App 自动重试
	#   - 浏览器与终端都看不到任何报错
	#
	# 放在站点级 handle_errors 而不是 reverse_proxy 的 handle_response:
	#   handle_response 只能拦截**上游真的返回了**的响应;容器没起时
	#   Caddy 自己生成的 502 走的是错误处理链,必须用 handle_errors 才能改写。
	#   已实测:上游 502 → /api/ping 变 200;其他路径的 502 保持不变。
	handle_errors {
		@ping_down expression {http.request.uri.path} == "/api/ping" && ({err.status_code} == 502 || {err.status_code} == 503 || {err.status_code} == 504)
		handle @ping_down {
			header Content-Type "application/json; charset=utf-8"
			respond "{\"ok\":false,\"error\":\"backend unavailable\"}" 200
		}
		# 其余错误保持原状态码,走 Caddy 默认错误页
		respond "{err.status_code}" {err.status_code}
	}

	handle /api/ping {
		reverse_proxy api:8787
	}

	handle /api/* {
		reverse_proxy api:8787
	}

	handle /admin* {
		reverse_proxy api:8787
	}

	handle /health {
		reverse_proxy api:8787
	}

	# ── 静态站点(SPA fallback)──
	handle {
		root * /srv

		# 目录索引优先(/download/ → /download/index.html),然后 SPA 路由回 index.html
		try_files {path} {path}/index.html /index.html
		file_server
	}
}
