# Salary Timer · Caddy 站点配置
#
# 站点地址:默认 persecond.work,可用服务器项目目录 .env 里的 SITE_DOMAIN 覆盖
# (Caddyfile 占位符 {$VAR:default}:变量未设置或为空时取默认值)
#
# 证书:Let's Encrypt 自动签发 + 自动续签(HTTP-01 走 80,TLS-ALPN-01 走 443,两者都可用)。
# 前提:阿里云安全组放行 80 和 443;域名 A 记录指向本机(已确认 persecond.work -> 47.104.228.220)。
#
# 端口归属:阿里云建站产品曾以容器形式抢占 80/443,deploy.yml 会在 compose up 之前
# 停掉占用这两个端口的非 work-timer 容器并禁止其自启,因此这里 80/443 都归 Caddy。
#
# 想临时用自签证书(比如域名还没解析好):把下面 tls 块整段替换成 `tls internal` 即可。

{$SITE_ADDRESS:persecond.work} {
	root * /srv
	encode zstd gzip

	# PWA:Service Worker 与 manifest 必须每次回源校验,否则新版本永远发不到客户端
	@pwa path /sw.js /manifest.webmanifest
	header @pwa Cache-Control "no-cache, no-store, must-revalidate"

	# HTML 不做强缓存,保证发版即时生效
	@html path / /index.html *.html
	header @html Cache-Control "no-cache"

	# 其余静态资源文件名带 hash,可以长期 immutable(sw.js 已被上面排除)
	@static {
		not path /sw.js
		path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.ttf *.eot
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	# 目录索引优先(/download/ → /download/index.html),然后 SPA 路由回 index.html
	try_files {path} {path}/index.html /index.html
	file_server
}
