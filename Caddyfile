# Salary Timer · Caddy 站点配置
#
# 站点地址:默认 persecond.work,可用服务器项目目录 .env 里的 SITE_DOMAIN 覆盖
# (Caddyfile 占位符 {$VAR:default}:变量未设置或为空时取默认值)
#
# 证书:Let's Encrypt 自动签发 + 自动续签,验证方式只用 TLS-ALPN-01(见下方 disable_http_challenge)。
# 前提:阿里云安全组放行 443;域名 A 记录指向本机(已确认 persecond.work -> 47.104.228.220)。
#
# 为什么不用 HTTP-01:宿主机 80 端口被阿里云建站产品自带的 OpenResty 占着(它返回 301 跳 https),
# ACME 的 HTTP-01 验证走不通;TLS-ALPN-01 在 443 上完成验证,与 80 端口无关。
# 副作用:80 上那个 OpenResty 的 301 正好把 http 访问转到我们的 https,无需我们自己监听 80。
#
# 想临时用自签证书(比如域名还没解析好):把下面 tls 块整段替换成 `tls internal` 即可。

{$SITE_ADDRESS:persecond.work} {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}

	root * /srv
	encode zstd gzip

	# PWA:Service Worker 与 manifest 必须每次回源校验,否则新版本永远发不到客户端
	@pwa path /sw.js /manifest.webmanifest
	header @pwa Cache-Control "no-cache, no-store, must-revalidate"

	# HTML 不做强缓存,保证发版即时生效
	@html path / /index.html *.html
	header @html Cache-Control "no-cache"

	# 其余静态资源文件名带 hash,可以长期 immutable(sw.js 已被上面排除)
	@static {
		not path /sw.js
		path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.ttf *.eot
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	# SPA 路由:任何不存在的路径回 index.html
	try_files {path} /index.html
	file_server
}
